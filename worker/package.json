{
	"name": "scrummy",
	"version": "1.0.0",
	"description": "Scrummy Worker and Durable Object POC",
	"scripts": {
		"dev": "npx wrangler dev",
		"publish": "npx wrangler publish",
		"format": "prettier --write  '*.{ts,js}' 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
		"lint": "eslint --max-warnings=0 src && prettier --check '*.{json,js}' 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
	},
	"author": "Taylor Smith <tsmith@tsmith.com>",
	"license": "",
	"eslintConfig": {
		"root": true,
		"extends": [
			"typescript",
			"prettier"
		]
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^3.14.1",
		"@types/jest": "^28.1.6",
		"@typescript-eslint/eslint-plugin": "^5.32.0",
		"@typescript-eslint/parser": "^5.32.0",
		"eslint": "^8.21.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-config-typescript": "^3.0.0",
		"jest": "^28.1.3",
		"jest-environment-miniflare": "^2.6.0",
		"miniflare": "^2.6.0",
		"prettier": "^2.7.1",
		"ts-jest": "^28.0.7",
		"typescript": "^4.7.4",
		"wrangler": "^2.0.24"
	},
	"dependencies": {
		"itty-router": "^3.0.11"
	}
}
